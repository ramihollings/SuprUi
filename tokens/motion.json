                },
                "stiffness": {
                    "$type": "number",
                    "$value": 260
                }
            },
            "snappy": {
                "damping": {
                    "$type": "number",
                    "$value": 30
                },
                "stiffness": {
                    "$type": "number",
                    "$value": 400
                }
            }
