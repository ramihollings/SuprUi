        "text-muted": {
          "$type": "color",
          "$value": "{color.black.800}"
        },
        "track": {
          "$description": "Unchecked Switch track fill. #737373 (black-700) in both themes: the track boundary vs the page is 4.43:1 dark / 4.74:1 light (WCAG 1.4.11 needs 3:1); the old surface/border-strong track was 1.06-2.03:1, and the native white thumb on the light track was 1.48:1.",
          "$type": "color",
          "$value": "{color.black.700}"
        },
        "warning": {
