          "$description": "Hover/pressed brand background. Cobalt-600 in both themes: white text on cobalt-400 (#4378F3) was 4.02:1, below AA 4.5:1."
        },
        "danger": {
          "$type": "color",
          "$value": "#EF4444",
          "$description": "Destructive / error text, border and icon red. Dark keeps #EF4444 (error text on black is 5.58:1); the filled danger Button uses danger-solid instead, because white text on #EF4444 is only 3.76:1."
        },
        "danger-hover": {
          "$description": "Danger button hover (web) / pressed (native) background. Darker than danger: white text stays 6.47:1, where opacity-based feedback fell to 3.31:1 (light) / 4.00:1 (dark).",
          "$type": "color",
          "$value": "#B91C1C"
        },
        "danger-solid": {
          "$description": "Filled danger Button background (rest state). #DC2626 in both themes: white label text is 4.83:1 (AA 4.5:1); hover/pressed uses danger-hover. Kept separate from danger because the text red cannot also be a button background in dark.",
          "$type": "color",
          "$value": "#DC2626"
        },
        "focus": {
          "$description": "Focus indicator. Always brand.",
          "$type": "color",
          "$value": "{color.cobalt.500}"
